# Turso (same database the Vercel app uses)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# VAPID — MUST be the same key pair configured in Vercel.
# Regenerating breaks every existing push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional tuning (defaults shown)
POLL_INTERVAL_MS=60000
BATCH_SIZE=50
MAX_ATTEMPTS=5
RATE_LIMIT_MS=1800000

# Set to "true" to run the full claim/process cycle without sending pushes
# or writing notification_log. Use for initial VPS verification.
DRY_RUN=false
