import Toybox.Application;
import Toybox.Background;
import Toybox.Attention;
import Toybox.Communications;
import Toybox.Graphics;
import Toybox.Lang;
import Toybox.System;
import Toybox.Timer;
import Toybox.Time;
import Toybox.WatchUi;

// McPhee on the watch: sleep/wake toggle, bottle feed and diaper logging.
// Talks to /api/watch with the bearer token from Secrets.mc (generated by
// build.sh, never committed). Every write is checked again on the server.

const APP_VERSION = "1.2.0";

const FEED_MIN_ML = 10;
const FEED_MAX_ML = 300;
const FEED_STEP_ML = 10;

(:background, :glance)
class McpheeApp extends Application.AppBase {
    var api as McpheeApi?;
    var mainMenu as McpheeMenu?;

    function initialize() {
        AppBase.initialize();
    }

    function getInitialView() as [WatchUi.Views] or [WatchUi.Views, WatchUi.InputDelegates] {
        var client = new McpheeApi();
        var menu = new McpheeMenu();
        api = client;
        mainMenu = menu;
        Background.registerForTemporalEvent(new Time.Duration(15 * 60));
        client.refresh();
        return [menu, new McpheeMenuDelegate()];
    }

    function getGlanceView() as [WatchUi.GlanceView] or [WatchUi.GlanceView, WatchUi.GlanceViewDelegate] or Null {
        return [new McpheeGlance()];
    }

    function getServiceDelegate() as [System.ServiceDelegate] {
        return [new McpheeService()];
    }
}

function getApp() as McpheeApp {
    return Application.getApp() as McpheeApp;
}

// Foreground accessors: these objects are never allocated in glance/service mode.
function getApi() as McpheeApi {
    return getApp().api as McpheeApi;
}

function getMainMenu() as McpheeMenu {
    return getApp().mainMenu as McpheeMenu;
}

// ---------------------------------------------------------------- API

class McpheeApi {
    var status as Dictionary?;
    var fetchedAt as Number = 0;
    var loading as Boolean = false;
    var lastError as String?;
    var pending as Method?;

    function initialize() {
    }

    function url() as String {
        return WATCH_SERVER_URL + "/api/watch";
    }

    function options(method as Communications.HttpRequestMethod) as Dictionary {
        return watchOptions(method);
    }

    function refresh() as Void {
        loading = true;
        lastError = null;
        getMainMenu().updateItems();
        Communications.makeWebRequest(url(), null, options(Communications.HTTP_REQUEST_METHOD_GET), method(:onStatus));
    }

    function onStatus(code as Number, data as Dictionary or String or Null) as Void {
        loading = false;
        if (code == 200 && data instanceof Dictionary) {
            setStatus(data);
        } else {
            lastError = errorText(code, data);
        }
        getMainMenu().updateItems();
    }

    // callback receives ok, message, and an opaque undo String (or null).
    function send(body as Dictionary, callback as Method) as Void {
        pending = callback;
        Communications.makeWebRequest(url(), body, options(Communications.HTTP_REQUEST_METHOD_POST), method(:onSend));
    }

    function onSend(code as Number, data as Dictionary or String or Null) as Void {
        var ok = code == 200;
        if (data instanceof Dictionary) {
            var fresh = data["status"];
            if (fresh instanceof Dictionary) {
                setStatus(fresh);
            }
        }
        getMainMenu().updateItems();
        var callback = pending;
        pending = null;
        if (callback != null) {
            var undo = data instanceof Dictionary ? data["undo"] : null;
            callback.invoke(ok, ok ? "Saved" : errorText(code, data), undo instanceof String ? undo : null);
        }
    }

    function setStatus(data as Dictionary) as Void {
        status = data;
        fetchedAt = System.getTimer();
        lastError = null;
        cacheWatchStatus(data);
    }

    function errorText(code as Number, data as Dictionary or String or Null) as String {
        if (data instanceof Dictionary) {
            if (data["code"] != null && data["code"].equals("AT_CHILDCARE")) {
                return "At childcare";
            }
            var message = data["error"];
            if (message instanceof String) {
                return message;
            }
        }
        if (code == Communications.BLE_CONNECTION_UNAVAILABLE) {
            return "Phone not connected";
        }
        if (code == Communications.NETWORK_REQUEST_TIMED_OUT) {
            return "No response";
        }
        if (code == 401) {
            return "Bad token";
        }
        if (code == 404) {
            return "Not set up on server";
        }
        return "Error " + code;
    }

    // Seconds since an event, counting time passed since the last fetch.
    function agoSec(key as String) as Number? {
        if (status == null) {
            return null;
        }
        var value = status[key];
        if (!(value instanceof Number)) {
            return null;
        }
        return (value as Number) + (System.getTimer() - fetchedAt) / 1000;
    }

    // Milliseconds since the last successful status read.
    function ageMs() as Number {
        return System.getTimer() - fetchedAt;
    }

    // "60ml 2h10, 90ml 5h05": the last two feeds, newest first. Falls back
    // to the single lastFeed field for older servers.
    function recentFeedsText() as String {
        if (status == null) {
            return "";
        }
        var sinceFetch = (System.getTimer() - fetchedAt) / 1000;
        var feeds = status["recentFeeds"];
        var parts = [] as Array<String>;
        if (feeds instanceof Array) {
            for (var i = 0; i < feeds.size() && i < 2; i++) {
                var item = feeds[i];
                if (item instanceof Dictionary && item["agoSec"] instanceof Number) {
                    parts.add(item["amount"] + "ml " + formatShort((item["agoSec"] as Number) + sinceFetch));
                }
            }
        } else {
            var feed = lastFeed();
            var ago = agoSec("lastFeedAgoSec");
            if (feed != null && ago != null) {
                parts.add(feed["amount"] + "ml " + formatShort(ago));
            }
        }
        if (parts.size() == 0) {
            return "No feeds yet";
        }
        return parts.size() == 1 ? parts[0] + " ago" : parts[0] + ", " + parts[1];
    }

    function isSleeping() as Boolean {
        return status != null && "sleeping".equals(status["state"]);
    }

    function atChildcare() as Boolean {
        return status != null && status["atChildcare"] == true;
    }

    function lastFeed() as Dictionary? {
        if (status == null) {
            return null;
        }
        var feed = status["lastFeed"];
        return feed instanceof Dictionary ? feed : null;
    }
}

function formatDuration(sec as Number?) as String {
    if (sec == null) {
        return "";
    }
    var minutes = sec / 60;
    if (minutes < 60) {
        return minutes + "m";
    }
    return (minutes / 60) + "h " + (minutes % 60) + "m";
}

// "45m" under an hour, else "2h10".
(:glance)
function formatShort(sec as Number) as String {
    var minutes = sec / 60;
    if (minutes < 60) {
        return minutes + "m";
    }
    return (minutes / 60) + "h" + (minutes % 60).format("%02d");
}

// ---------------------------------------------------------------- Main menu

class McpheeMenu extends WatchUi.Menu2 {
    function initialize() {
        Menu2.initialize({ :title => "McPhee" });
        addItem(new WatchUi.MenuItem("Sleep / Wake", "Loading...", :sleep, null));
        addItem(new WatchUi.MenuItem("Feed", "", :feed, null));
        addItem(new WatchUi.MenuItem("Diaper", "", :diaper, null));
    }

    function onShow() as Void {
        Menu2.onShow();
        var api = getApi();
        if (api.status != null && !api.loading && api.pending == null && api.ageMs() > 60000) {
            api.refresh();
        } else {
            updateItems();
        }
    }

    function updateItems() as Void {
        var api = getApi();
        var sleepItem = getItem(0) as WatchUi.MenuItem;
        var feedItem = getItem(1) as WatchUi.MenuItem;
        var diaperItem = getItem(2) as WatchUi.MenuItem;

        if (api.status == null) {
            sleepItem.setLabel("Sleep / Wake");
            sleepItem.setSubLabel(api.loading ? "Loading..." : (api.lastError != null ? api.lastError : "Tap to retry"));
            feedItem.setSubLabel("");
            diaperItem.setSubLabel("");
            WatchUi.requestUpdate();
            return;
        }

        var name = api.status["babyName"];
        setTitle(api.loading ? "Updating..." : (api.atChildcare() ? "At childcare" : (name instanceof String ? name : "McPhee")));

        var since = formatDuration(api.agoSec("sinceAgoSec"));
        if (api.isSleeping()) {
            sleepItem.setLabel("Wake up");
            sleepItem.setSubLabel("Asleep " + since);
        } else {
            sleepItem.setLabel("Sleep");
            sleepItem.setSubLabel(since.equals("") ? "Awake" : "Awake " + since);
        }

        feedItem.setSubLabel(api.recentFeedsText());

        var diaperAgo = api.agoSec("lastDiaperAgoSec");
        diaperItem.setSubLabel(diaperAgo == null ? "None yet" : formatDuration(diaperAgo) + " ago");

        if (api.lastError != null) {
            sleepItem.setSubLabel(api.lastError);
        }
        WatchUi.requestUpdate();
    }
}

class McpheeMenuDelegate extends WatchUi.Menu2InputDelegate {
    function initialize() {
        Menu2InputDelegate.initialize();
    }

    function onSelect(item as WatchUi.MenuItem) as Void {
        var api = getApi();
        if (api.status == null) {
            if (!api.loading) {
                api.refresh();
            }
            return;
        }
        if (api.atChildcare() && api.ageMs() > 15000) {
            // Checked out on the phone since? Re-check before blocking.
            if (!api.loading) {
                api.refresh();
            }
            return;
        }
        if (api.atChildcare()) {
            var blocked = new ResultView(false, "At childcare. Log on the phone.");
            WatchUi.pushView(blocked, new ResultDelegate(blocked), WatchUi.SLIDE_UP);
            return;
        }
        var id = item.getId();
        if (id == :sleep) {
            var sleeping = api.isSleeping();
            showWhen(sleeping ? "Wake up" : "Start sleep", { "action" => sleeping ? "wake" : "sleep" }, 0);
        } else if (id == :feed) {
            var menu = new WatchUi.Menu2({ :title => "Feed" });
            menu.addItem(new WatchUi.MenuItem("Breast milk", null, "breastmilk", null));
            menu.addItem(new WatchUi.MenuItem("Formula", null, "formula", null));
            var feed = api.lastFeed();
            if (feed != null && "formula".equals(feed["milkType"])) {
                menu.setFocus(1);
            }
            WatchUi.pushView(menu, new FeedTypeDelegate(), WatchUi.SLIDE_LEFT);
        } else if (id == :diaper) {
            var menu = new WatchUi.Menu2({ :title => "Diaper" });
            menu.addItem(new WatchUi.MenuItem("Pee", null, "pee", null));
            menu.addItem(new WatchUi.MenuItem("Poo", null, "poo", null));
            menu.addItem(new WatchUi.MenuItem("Both", null, "both", null));
            WatchUi.pushView(menu, new DiaperDelegate(), WatchUi.SLIDE_LEFT);
        }
    }
}

// ---------------------------------------------------------------- Saving

// Pushes a "Saving" screen, sends the request, then swaps in the result.
class SaveFlow {
    var body as Dictionary;

    function initialize(requestBody as Dictionary) {
        body = requestBody;
    }

    function start() as Void {
        var progress = new WatchUi.ProgressBar(isUndo() ? "Undoing..." : "Saving...", null);
        if (isUndo()) {
            WatchUi.switchToView(progress, new BusyDelegate(), WatchUi.SLIDE_IMMEDIATE);
        } else {
            WatchUi.pushView(progress, new BusyDelegate(), WatchUi.SLIDE_IMMEDIATE);
        }
        getApi().send(body, method(:onDone));
    }

    function isUndo() as Boolean {
        return "undo".equals(body["action"]);
    }

    function onDone(ok as Boolean, message as String, undo as String?) as Void {
        if (ok) {
            vibrate(1);
        } else {
            vibrate(2);
        }
        var result = new ResultView(ok, message);
        result.isUndo = isUndo();
        result.undoToken = ok && !isUndo() ? undo : null;
        WatchUi.switchToView(result, new ResultDelegate(result), WatchUi.SLIDE_IMMEDIATE);
    }
}

function vibrate(pulses as Number) as Void {
    if (!(Attention has :vibrate)) {
        return;
    }
    var pattern = [] as Array<Attention.VibeProfile>;
    for (var i = 0; i < pulses; i++) {
        pattern.add(new Attention.VibeProfile(60, 150));
        pattern.add(new Attention.VibeProfile(0, 120));
    }
    Attention.vibrate(pattern);
}

class BusyDelegate extends WatchUi.BehaviorDelegate {
    function initialize() {
        BehaviorDelegate.initialize();
    }

    // Ignore back while the request is in flight; the result screen follows.
    function onBack() as Boolean {
        return true;
    }
}

// Keep the choice screens underneath When so Back can revise the choice.
// On save, unwind all of them so the result closes directly to the main menu.
function showWhen(title as String, body as Dictionary, parents as Number) as Void {
    var menu = new WatchUi.Menu2({ :title => title });
    menu.addItem(new WatchUi.MenuItem("Now", null, 0, null));
    menu.addItem(new WatchUi.MenuItem("5 min ago", null, 5, null));
    menu.addItem(new WatchUi.MenuItem("15 min ago", null, 15, null));
    menu.addItem(new WatchUi.MenuItem("30 min ago", null, 30, null));
    menu.setFocus(0);
    WatchUi.pushView(menu, new WhenDelegate(body, parents), WatchUi.SLIDE_LEFT);
}

class WhenDelegate extends WatchUi.Menu2InputDelegate {
    var body as Dictionary;
    var parents as Number;

    function initialize(requestBody as Dictionary, parentCount as Number) {
        Menu2InputDelegate.initialize();
        body = requestBody;
        parents = parentCount;
    }

    function onSelect(item as WatchUi.MenuItem) as Void {
        body["minutesAgo"] = item.getId();
        for (var i = 0; i <= parents; i++) {
            WatchUi.popView(WatchUi.SLIDE_IMMEDIATE);
        }
        new SaveFlow(body).start();
    }
}

class DiaperDelegate extends WatchUi.Menu2InputDelegate {
    function initialize() {
        Menu2InputDelegate.initialize();
    }

    function onSelect(item as WatchUi.MenuItem) as Void {
        showWhen("When", { "action" => "diaper", "kind" => item.getId() }, 1);
    }
}

class FeedTypeDelegate extends WatchUi.Menu2InputDelegate {
    function initialize() {
        Menu2InputDelegate.initialize();
    }

    function onSelect(item as WatchUi.MenuItem) as Void {
        var milkType = item.getId() as String;
        var start = 120;
        var feed = getApi().lastFeed();
        if (feed != null && feed["amount"] instanceof Number) {
            start = feed["amount"] as Number;
        }
        var factory = new AmountFactory();
        var picker = new WatchUi.Picker({
            :title => new WatchUi.Text({
                :text => milkType.equals("formula") ? "Formula ml" : "Breast milk ml",
                :locX => WatchUi.LAYOUT_HALIGN_CENTER,
                :locY => WatchUi.LAYOUT_VALIGN_BOTTOM,
                :color => Graphics.COLOR_WHITE
            }),
            :pattern => [factory],
            :defaults => [factory.indexOf(start)]
        });
        WatchUi.pushView(picker, new AmountDelegate(milkType), WatchUi.SLIDE_LEFT);
    }
}

class AmountFactory extends WatchUi.PickerFactory {
    function initialize() {
        PickerFactory.initialize();
    }

    function getSize() as Number {
        return (FEED_MAX_ML - FEED_MIN_ML) / FEED_STEP_ML + 1;
    }

    function getValue(index as Number) as Object? {
        return FEED_MIN_ML + index * FEED_STEP_ML;
    }

    function getDrawable(index as Number, selected as Boolean) as WatchUi.Drawable? {
        return new WatchUi.Text({
            :text => getValue(index).toString(),
            :color => Graphics.COLOR_WHITE,
            :font => Graphics.FONT_NUMBER_MEDIUM,
            :locX => WatchUi.LAYOUT_HALIGN_CENTER,
            :locY => WatchUi.LAYOUT_VALIGN_CENTER
        });
    }

    function indexOf(ml as Number) as Number {
        var index = ((ml + FEED_STEP_ML / 2) - FEED_MIN_ML) / FEED_STEP_ML;
        if (index < 0) {
            return 0;
        }
        if (index >= getSize()) {
            return getSize() - 1;
        }
        return index;
    }
}

class AmountDelegate extends WatchUi.PickerDelegate {
    var milkType as String;

    function initialize(type as String) {
        PickerDelegate.initialize();
        milkType = type;
    }

    function onAccept(values as Array) as Boolean {
        var amount = values[0] as Number;
        showWhen("When", { "action" => "feed", "milkType" => milkType, "amount" => amount }, 2);
        return true;
    }

    function onCancel() as Boolean {
        WatchUi.popView(WatchUi.SLIDE_RIGHT);
        return true;
    }
}

// ---------------------------------------------------------------- Result

class ResultView extends WatchUi.View {
    var ok as Boolean;
    var message as String;
    var timer as Timer.Timer?;
    var undoToken as String?;
    var undoUntil as Number = 0;
    var isUndo as Boolean = false;

    function initialize(success as Boolean, text as String) {
        View.initialize();
        ok = success;
        message = text;
    }

    function onShow() as Void {
        timer = new Timer.Timer();
        undoUntil = System.getTimer() + 10000;
        timer.start(method(:close), undoToken != null ? 10000 : (ok ? 1500 : 3500), false);
    }

    function onHide() as Void {
        if (timer != null) {
            timer.stop();
            timer = null;
        }
    }

    function close() as Void {
        timer = null;
        WatchUi.popView(WatchUi.SLIDE_DOWN);
    }

    function onUpdate(dc as Graphics.Dc) as Void {
        dc.setColor(Graphics.COLOR_BLACK, Graphics.COLOR_BLACK);
        dc.clear();
        var cx = dc.getWidth() / 2;
        var cy = dc.getHeight() / 2;
        dc.setColor(ok ? 0x7FBF7F : 0xE07A5F, Graphics.COLOR_TRANSPARENT);
        var title = isUndo ? (ok ? "Undone" : "Not undone") : (ok ? "Saved" : "Not saved");
        dc.drawText(cx, cy - 50, Graphics.FONT_LARGE, title, Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER);
        if (ok && undoToken != null) {
            dc.setColor(Graphics.COLOR_WHITE, Graphics.COLOR_TRANSPARENT);
            dc.drawText(cx, cy + 20, Graphics.FONT_SMALL, "Tap to undo", Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER);
        } else if (!ok) {
            dc.setColor(Graphics.COLOR_WHITE, Graphics.COLOR_TRANSPARENT);
            var wrapped = Graphics.fitTextToArea(message, Graphics.FONT_SMALL, dc.getWidth() * 3 / 4, dc.getHeight() / 2, true);
            dc.drawText(cx, cy + 20, Graphics.FONT_SMALL, wrapped == null ? message : wrapped, Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER);
        }
    }
}

class ResultDelegate extends WatchUi.BehaviorDelegate {
    var view as ResultView;

    function initialize(result as ResultView) {
        BehaviorDelegate.initialize();
        view = result;
    }

    function onSelect() as Boolean {
        var undo = view.undoToken;
        view.undoToken = null; // Consume once, before starting a request.
        if (undo != null && System.getTimer() <= view.undoUntil) {
            new SaveFlow({ "action" => "undo", "undo" => undo }).start();
        } else {
            WatchUi.popView(WatchUi.SLIDE_DOWN);
        }
        return true;
    }

    function onBack() as Boolean {
        WatchUi.popView(WatchUi.SLIDE_DOWN);
        return true;
    }

    function onTap(event as WatchUi.ClickEvent) as Boolean {
        return onSelect();
    }
}
